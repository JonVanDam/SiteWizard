# Dependencies
node_modules/

# Build output
dist/
build/
out/

# Generated reports / screenshots
test-data/output/*
!test-data/output/.gitkeep

# Electron per-user settings (normally lives in app data, ignored here just in case)
sitewizard-settings.json

# Logs
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Local working data (internal / not for publication)
.data/

# Excel lock files (created while a workbook is open)
~$*
